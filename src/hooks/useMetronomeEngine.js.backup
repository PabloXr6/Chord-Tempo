"use client";
import { useState, useEffect, useRef, useCallback } from 'react';

export const useMetronomeEngine = () => {
  const [isPlaying, setIsPlaying] = useState(false);
  const [bpm, setBpmState] = useState(120);
  const [timeSignature, setTimeSignatureState] = useState('4/4');
  const [volume, setVolumeState] = useState(80);
  const [subdivisions, setSubdivisionsState] = useState('off');
  const [accentPattern, setAccentPatternState] = useState('1,0,0,0');
  const [currentBeat, setCurrentBeat] = useState(0);

  const audioCtxRef = useRef(null);
  const nextNoteTimeRef = useRef(0);
  const currentNoteRef = useRef(0);
  const timerIdRef = useRef(null);
  const tapTimesRef = useRef([]);

  const initAudio = useCallback(() => {
    if (!audioCtxRef.current) {
      audioCtxRef.current = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtxRef.current.state === 'suspended') {
      audioCtxRef.current.resume();
    }
  }, []);

  const setBPM = useCallback((newBpm) => setBpmState(Math.max(30, Math.min(300, newBpm))), []);
  const setTimeSignature = useCallback((ts) => setTimeSignatureState(ts), []);
  const setVolume = useCallback((v) => setVolumeState(Math.max(0, Math.min(100, v))), []);
  const setSubdivisions = useCallback((s) => setSubdivisionsState(s), []);
  const setAccentPattern = useCallback((p) => setAccentPatternState(p), []);

  useEffect(() => {
    return () => {
      if (audioCtxRef.current && audioCtxRef.current.state !== 'closed') {
        audioCtxRef.current.close();
      }
      if (timerIdRef.current) clearTimeout(timerIdRef.current);
    };
  }, []);

  const playClick = useCallback((time, type) => {
    if (!audioCtxRef.current) return;
    const ctx = audioCtxRef.current;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    
    osc.connect(gain);
    gain.connect(ctx.destination);
    
    const vol = volume / 100;

    if (type === 'downbeat') {
      osc.frequency.value = 1000;
      gain.gain.setValueAtTime(vol, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
      osc.start(time);
      osc.stop(time + 0.1);
    } else if (type === 'regular') {
      osc.frequency.value = 800;
      gain.gain.setValueAtTime(vol, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.08);
      osc.start(time);
      osc.stop(time + 0.08);
    } else {
      osc.frequency.value = 600;
      gain.gain.setValueAtTime(vol * 0.5, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.06);
      osc.start(time);
      osc.stop(time + 0.06);
    }
  }, [volume]);

  const play = useCallback(() => {
    if (isPlaying) return;
    initAudio();
    currentNoteRef.current = 0;
    nextNoteTimeRef.current = audioCtxRef.current.currentTime + 0.05;
    scheduler();
    setIsPlaying(true);
  }, [isPlaying, scheduler, initAudio]);

  const scheduler = useCallback(() => {
    if (!audioCtxRef.current) return;
    const ctx = audioCtxRef.current;
    const beatsPerMeasure = parseInt(timeSignature.split('/')[0]) || 4;
    
    let subDivCount = 1;
    if (subdivisions === '8th') subDivCount = 2;
    if (subdivisions === 'triplet') subDivCount = 3;
    if (subdivisions === '16th') subDivCount = 4;

    const secondsPerBeat = 60.0 / bpm;
    const secondsPerNote = secondsPerBeat / subDivCount;

    while (nextNoteTimeRef.current < ctx.currentTime + 0.1) {
      const beatInMeasure = Math.floor(currentNoteRef.current / subDivCount) % beatsPerMeasure;
      const isSubdivision = currentNoteRef.current % subDivCount !== 0;
      
      let type = 'regular';
      if (isSubdivision) {
        type = 'subdivision';
      } else {
        const pattern = accentPattern.split(',').map(Number);
        const isAccent = pattern[beatInMeasure] === 1;
        if (isAccent || (beatInMeasure === 0 && accentPattern === '')) {
          type = 'downbeat';
        }
      }

      playClick(nextNoteTimeRef.current, type);

      if (!isSubdivision) {
        const timeToNote = (nextNoteTimeRef.current - ctx.currentTime) * 1000;
        setTimeout(() => setCurrentBeat(beatInMeasure), Math.max(0, timeToNote));
      }

      nextNoteTimeRef.current += secondsPerNote;
      currentNoteRef.current++;
    }
    timerIdRef.current = setTimeout(scheduler, 25);
  }, [bpm, timeSignature, subdivisions, accentPattern, playClick]);

  const stop = useCallback(() => {

  const stop = useCallback(() => {
    if (timerIdRef.current) clearTimeout(timerIdRef.current);
    setIsPlaying(false);
    setCurrentBeat(0);
    currentNoteRef.current = 0;
  }, []);

  const pause = useCallback(() => {
    if (timerIdRef.current) clearTimeout(timerIdRef.current);
    setIsPlaying(false);
  }, []);

  const tapTempo = useCallback(() => {
    const now = Date.now();
    tapTimesRef.current.push(now);
    if (tapTimesRef.current.length > 4) tapTimesRef.current.shift();
    
    if (tapTimesRef.current.length >= 2) {
      const intervals = [];
      for (let i = 1; i < tapTimesRef.current.length; i++) {
        intervals.push(tapTimesRef.current[i] - tapTimesRef.current[i - 1]);
      }
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      const newBpm = Math.round(60000 / avg);
      if (newBpm >= 30 && newBpm <= 300) setBpmState(newBpm);
    }
    
    setTimeout(() => {
      if (tapTimesRef.current.length > 0 && Date.now() - tapTimesRef.current[tapTimesRef.current.length - 1] > 2000) {
        tapTimesRef.current = [];
      }
    }, 2000);
  }, []);

  return {
    isPlaying: () => isPlaying,
    play, 
    stop, 
    pause,
    bpm, 
    setBPM,
    timeSignature, 
    setTimeSignature,
    volume, 
    setVolume,
    subdivisions, 
    setSubdivisions,
    accentPattern, 
    setAccentPattern,
    tapTempo, 
    currentBeat,
    getCurrentBPM: () => bpm,
    getCurrentVolume: () => volume
  };
};

export default useMetronomeEngine;